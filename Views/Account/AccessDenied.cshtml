@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center animate-fade-in-up" style="max-width: 600px; margin-top: 100px;">
    <div class="glass-card p-5 border-danger">
        <i class="bi bi-shield-slash-fill text-danger" style="font-size: 4rem;"></i>
        <h2 class="fw-bold mt-3 text-white">Access Denied</h2>
        <p class="text-secondary mt-3">
            You do not have the required permissions to view this section. The admin panel is strictly reserved for administrative accounts.
        </p>
        <div class="mt-4 gap-3 d-flex justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-camping-primary">
                <i class="bi bi-house-door me-2"></i>Return Home
            </a>
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Admin/Dashboard" class="btn btn-camping-outline">
                <i class="bi bi-person-fill me-2"></i>Log in as Admin
            </a>
        </div>
    </div>
</div>
