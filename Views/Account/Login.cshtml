@model AGY.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container animate-fade-in-up">
    <div class="auth-container glass-card p-5">
        <div class="text-center mb-4">
            <i class="bi bi-compass-fill text-primary" style="font-size: 3rem;"></i>
            <h2 class="fw-bold mt-2">Welcome Back</h2>
            <p class="text-secondary">Sign in to check out, view your orders, and post product comments.</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.9rem;"></div>

            <div class="form-floating-custom">
                <input asp-for="Email" placeholder=" " required />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger d-block mt-1" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-floating-custom">
                <input asp-for="Password" placeholder=" " required />
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="RememberMe" />
                <label class="form-check-label text-secondary" asp-for="RememberMe">
                    Remember me on this device
                </label>
            </div>

            <button type="submit" class="btn btn-camping-primary w-100 py-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <!-- Quick Demo Credentials Display -->
        <div class="mt-4 p-3 rounded bg-dark border border-secondary text-start" style="font-size: 0.85rem;">
            <div class="text-warning fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i>Demo Accounts Available:</div>
            <div><strong class="text-white">Admin Account:</strong> <code>admin@camping.com</code> / <code>Admin123!</code></div>
            <div><strong class="text-white">User Account:</strong> <code>user@camping.com</code> / <code>User123!</code></div>
        </div>

        <div class="text-center mt-4">
            <p class="text-secondary mb-0">New to the gear? <a asp-action="Register" class="text-primary text-decoration-none fw-bold">Create Account Here</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
