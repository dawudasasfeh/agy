@model IEnumerable<AGY.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">My Orders</li>
                </ol>
            </nav>
            <h2 class="fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>My Order History</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card p-5 text-center my-4">
            <i class="bi bi-bag-x-fill text-secondary" style="font-size: 3rem;"></i>
            <h4 class="mt-3 font-weight-bold">No Orders Placed Yet</h4>
            <p class="text-secondary">When you buy gear, your order details and receipts will be stored here.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-camping-primary mt-3">
                <i class="bi bi-cart3 me-2"></i>Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="glass-card p-4">
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Recipient</th>
                            <th>Status</th>
                            <th>Total Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong class="text-white">#@order.Id</strong></td>
                                <td>@order.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")</td>
                                <td>@order.FullName</td>
                                <td>
                                    @if (order.Status == "Processing")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Processing</span>
                                    }
                                    else if (order.Status == "Completed")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                    }
                                </td>
                                <td><strong class="text-primary">$@order.TotalAmount.ToString("N2")</strong></td>
                                <td class="text-end">
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-camping-outline btn-sm rounded-pill px-3">
                                        <i class="bi bi-file-earmark-text me-1"></i>View Invoice
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
