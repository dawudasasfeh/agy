@model AGY.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="container animate-fade-in-up">
    <div class="auth-container glass-card p-5">
        <div class="text-center mb-4">
            <i class="bi bi-compass-fill text-primary" style="font-size: 3rem;"></i>
            <h2 class="fw-bold mt-2">Join the Expedition</h2>
            <p class="text-secondary">Register to start saving items to your wishlist, tracking orders, and writing reviews.</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.9rem;"></div>

            <div class="form-floating-custom">
                <input asp-for="Email" placeholder=" " required />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger d-block mt-1" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-floating-custom">
                <input asp-for="Password" placeholder=" " required />
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-floating-custom">
                <input asp-for="ConfirmPassword" placeholder=" " required />
                <label asp-for="ConfirmPassword"></label>
                <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn btn-camping-primary w-100 py-3 mt-3">
                <i class="bi bi-person-plus-fill me-2"></i>Create Account
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-secondary mb-0">Already have an account? <a asp-action="Login" class="text-primary text-decoration-none fw-bold">Sign In Here</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
