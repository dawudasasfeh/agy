@model AGY.Models.Category
@{
    ViewData["Title"] = "Create Category";
}

<div class="admin-layout mt-4 glass-card overflow-hidden">
    <!-- Admin Sidebar -->
    <div class="admin-sidebar">
        <h5 class="text-white fw-bold mb-4 px-3"><i class="bi bi-gear-fill text-primary me-2"></i>Admin Panel</h5>
        <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Products" class="sidebar-link">
            <i class="bi bi-box-seam"></i> Products
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="sidebar-link active">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="sidebar-link">
            <i class="bi bi-receipt"></i> Orders
        </a>
        <a asp-controller="Admin" asp-action="Reviews" class="sidebar-link">
            <i class="bi bi-chat-text"></i> Reviews
        </a>
        <a asp-controller="Admin" asp-action="Testimonials" class="sidebar-link">
            <i class="bi bi-star"></i> Testimonials
        </a>
        <hr class="border-secondary my-4">
        <a asp-controller="Home" asp-action="Index" class="sidebar-link text-warning">
            <i class="bi bi-box-arrow-left"></i> View Live Site
        </a>
    </div>

    <!-- Admin Content Area -->
    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="fw-bold text-white mb-0">Create Category</h2>
            <a asp-action="Categories" class="btn btn-camping-outline rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>

        <div class="glass-card p-4 animate-fade-in-up" style="max-width: 600px;">
            <form asp-action="CreateCategory" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.9rem;"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-secondary" style="font-size: 0.85rem;">Category Name</label>
                    <input asp-for="Name" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-secondary" style="font-size: 0.85rem;">Description</label>
                    <textarea asp-for="Description" class="form-control bg-dark border-secondary text-white" rows="4" required style="resize: none;"></textarea>
                    <span asp-validation-for="Description" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary" style="font-size: 0.85rem;">Category Image</label>
                    <input type="file" name="imageFile" accept="image/*" class="form-control bg-dark border-secondary text-white" />
                    <small class="text-muted d-block mt-1">* Only image files (.jpg, .png, etc.) are allowed.</small>
                </div>

                <button type="submit" class="btn btn-camping-primary w-100 py-2">
                    <i class="bi bi-check-lg me-1"></i>Save Category
                </button>
            </form>
        </div>
    </div>
</div>
