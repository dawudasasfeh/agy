@model IEnumerable<AGY.Models.Order>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-layout mt-4 glass-card overflow-hidden">
    <!-- Admin Sidebar -->
    <div class="admin-sidebar">
        <h5 class="text-white fw-bold mb-4 px-3"><i class="bi bi-gear-fill text-primary me-2"></i>Admin Panel</h5>
        <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link active">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Products" class="sidebar-link">
            <i class="bi bi-box-seam"></i> Products
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="sidebar-link">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="sidebar-link">
            <i class="bi bi-receipt"></i> Orders
        </a>
        <a asp-controller="Admin" asp-action="Reviews" class="sidebar-link">
            <i class="bi bi-chat-text"></i> Reviews
        </a>
        <a asp-controller="Admin" asp-action="Testimonials" class="sidebar-link">
            <i class="bi bi-star"></i> Testimonials
        </a>
        <hr class="border-secondary my-4">
        <a asp-controller="Home" asp-action="Index" class="sidebar-link text-warning">
            <i class="bi bi-box-arrow-left"></i> View Live Site
        </a>
    </div>

    <!-- Admin Content Area -->
    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="fw-bold text-white mb-0">Dashboard Overview</h2>
            <span class="text-secondary" style="font-size: 0.9rem;">Welcome back, Administrator</span>
        </div>

        <!-- Metric Cards Grid -->
        <div class="row g-3 mb-5 animate-fade-in-up">
            <div class="col-md-3">
                <div class="metric-card">
                    <div>
                        <div class="metric-title">Total Users</div>
                        <div class="metric-value">@ViewBag.TotalUsers</div>
                    </div>
                    <i class="bi bi-people metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div>
                        <div class="metric-title">Total Products</div>
                        <div class="metric-value">@ViewBag.TotalProducts</div>
                    </div>
                    <i class="bi bi-box-seam metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div>
                        <div class="metric-title">Categories</div>
                        <div class="metric-value">@ViewBag.TotalCategories</div>
                    </div>
                    <i class="bi bi-tags metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div>
                        <div class="metric-title">Total Orders</div>
                        <div class="metric-value">@ViewBag.TotalOrders</div>
                    </div>
                    <i class="bi bi-receipt metric-icon"></i>
                </div>
            </div>
        </div>

        <!-- Recent Orders Panel -->
        <div class="glass-card p-4 animate-fade-in-up" style="animation-delay: 0.1s;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold text-white mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent Orders</h4>
                <a asp-action="Orders" class="btn btn-camping-outline btn-sm rounded-pill px-3">View All Orders</a>
            </div>

            @if (!Model.Any())
            {
                <p class="text-secondary text-center py-4 mb-0">No orders placed in the system yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong class="text-white">#@order.Id</strong></td>
                                    <td>
                                        <div class="fw-bold text-white">@order.FullName</div>
                                        <small class="text-secondary">@order.Email</small>
                                    </td>
                                    <td>@order.OrderDate.ToString("MMMM dd, yyyy")</td>
                                    <td>
                                        @if (order.Status == "Processing")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Processing</span>
                                        }
                                        else if (order.Status == "Completed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                        }
                                    </td>
                                    <td><strong class="text-primary">$@order.TotalAmount.ToString("N2")</strong></td>
                                    <td class="text-end">
                                        <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-camping-outline btn-sm rounded-pill px-3">
                                            Invoice
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
