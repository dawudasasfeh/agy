@model IEnumerable<AGY.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="admin-layout mt-4 glass-card overflow-hidden">
    <!-- Admin Sidebar -->
    <div class="admin-sidebar">
        <h5 class="text-white fw-bold mb-4 px-3"><i class="bi bi-gear-fill text-primary me-2"></i>Admin Panel</h5>
        <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Products" class="sidebar-link">
            <i class="bi bi-box-seam"></i> Products
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="sidebar-link active">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="sidebar-link">
            <i class="bi bi-receipt"></i> Orders
        </a>
        <a asp-controller="Admin" asp-action="Reviews" class="sidebar-link">
            <i class="bi bi-chat-text"></i> Reviews
        </a>
        <a asp-controller="Admin" asp-action="Testimonials" class="sidebar-link">
            <i class="bi bi-star"></i> Testimonials
        </a>
        <hr class="border-secondary my-4">
        <a asp-controller="Home" asp-action="Index" class="sidebar-link text-warning">
            <i class="bi bi-box-arrow-left"></i> View Live Site
        </a>
    </div>

    <!-- Admin Content Area -->
    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="fw-bold text-white mb-0">Manage Categories</h2>
            <a asp-action="CreateCategory" class="btn btn-camping-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Category
            </a>
        </div>

        <div class="glass-card p-4 animate-fade-in-up">
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th class="text-center">Products Count</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=100&q=80" : cat.ImageUrl)" 
                                         alt="@cat.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover; border: 1px solid var(--border-color);" />
                                </td>
                                <td><strong class="text-white">@cat.Name</strong></td>
                                <td>
                                    <div class="text-secondary" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@cat.Description">
                                        @cat.Description
                                    </div>
                                </td>
                                <td class="text-center text-white">@cat.Products.Count</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="EditCategory" asp-route-id="@cat.Id" class="btn btn-camping-outline btn-sm rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>

                                        <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this category? This will delete all products in it.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
