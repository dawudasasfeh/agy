@model IEnumerable<AGY.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="admin-layout mt-4 glass-card overflow-hidden">
    <!-- Admin Sidebar -->
    <div class="admin-sidebar">
        <h5 class="text-white fw-bold mb-4 px-3"><i class="bi bi-gear-fill text-primary me-2"></i>Admin Panel</h5>
        <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Products" class="sidebar-link active">
            <i class="bi bi-box-seam"></i> Products
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="sidebar-link">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="sidebar-link">
            <i class="bi bi-receipt"></i> Orders
        </a>
        <a asp-controller="Admin" asp-action="Reviews" class="sidebar-link">
            <i class="bi bi-chat-text"></i> Reviews
        </a>
        <a asp-controller="Admin" asp-action="Testimonials" class="sidebar-link">
            <i class="bi bi-star"></i> Testimonials
        </a>
        <hr class="border-secondary my-4">
        <a asp-controller="Home" asp-action="Index" class="sidebar-link text-warning">
            <i class="bi bi-box-arrow-left"></i> View Live Site
        </a>
    </div>

    <!-- Admin Content Area -->
    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="fw-bold text-white mb-0">Manage Products</h2>
            <a asp-action="CreateProduct" class="btn btn-camping-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        </div>

        <div class="glass-card p-4 animate-fade-in-up">
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock Quantity</th>
                            <th class="text-center">Image Count</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in Model)
                        {
                            var mainImage = prod.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=100&q=80";
                            <tr>
                                <td>
                                    <img src="@mainImage" alt="@prod.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover; border: 1px solid var(--border-color);" />
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@prod.Name</div>
                                    <small class="text-secondary">ID: #@prod.Id</small>
                                </td>
                                <td><span class="badge bg-secondary">@prod.Category?.Name</span></td>
                                <td><strong class="text-primary">$@prod.Price.ToString("N2")</strong></td>
                                <td>
                                    @if (prod.StockQuantity <= 0)
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i>Out of Stock (0)</span>
                                    }
                                    else if (prod.StockQuantity <= 3)
                                    {
                                        <span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock (@prod.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>In Stock (@prod.StockQuantity)</span>
                                    }
                                </td>
                                <td class="text-center text-white">@prod.Images.Count</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-camping-outline btn-sm rounded-pill px-3" target="_blank">
                                            View
                                        </a>
                                        <a asp-action="EditProduct" asp-route-id="@prod.Id" class="btn btn-camping-outline btn-sm rounded-pill px-3">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteProduct" asp-route-id="@prod.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
