@model AGY.Controllers.CheckoutViewModel
@{
    ViewData["Title"] = "Secure Checkout";
    var cart = ViewBag.Cart as List<AGY.Models.CartItemViewModel> ?? new List<AGY.Models.CartItemViewModel>();
    var cartTotal = ViewBag.CartTotal as decimal? ?? 0m;
}

<div class="container animate-fade-in-up">
    <!-- Breadcrumbs -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none">Cart</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Checkout</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-white"><i class="bi bi-shield-check text-primary me-2"></i>Secure Checkout</h2>
        <p class="text-secondary">Please complete your shipping information and payment details below.</p>
    </div>

    <form asp-action="PlaceOrder" method="post">
        @Html.AntiForgeryToken()
        <div class="row">
            <!-- Form Column -->
            <div class="col-lg-7 mb-4">
                <!-- Shipping Info -->
                <div class="glass-card p-4 mb-4">
                    <h5 class="fw-bold text-white mb-4"><i class="bi bi-truck text-primary me-2"></i>Shipping Details</h5>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="FullName" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <input asp-for="FullName" class="form-control bg-dark border-secondary text-white" placeholder="John Doe" required />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <input asp-for="Email" class="form-control bg-dark border-secondary text-white" type="email" required />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <input asp-for="Phone" class="form-control bg-dark border-secondary text-white" placeholder="+962 7X XXX XXXX" required />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label asp-for="ShippingAddress" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <textarea asp-for="ShippingAddress" class="form-control bg-dark border-secondary text-white" rows="3" placeholder="Country, City, Street name, Building No..." required style="resize: none;"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                </div>

                <!-- Simulated External Payment Gateway Form -->
                <div class="glass-card p-4">
                    <h5 class="fw-bold text-white mb-3"><i class="bi bi-credit-card text-primary me-2"></i>Simulated External Payment</h5>
                    <p class="text-secondary mb-4" style="font-size: 0.85rem;">
                        This store integrates with external payment gateways. Enter any valid test card info below to simulate payment authorization.
                    </p>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="CardNumber" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-credit-card-2-back-fill"></i></span>
                                <input asp-for="CardNumber" class="form-control bg-dark border-secondary text-white" placeholder="4111 1111 1111 1111" required />
                            </div>
                            <span asp-validation-for="CardNumber" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpirationDate" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <input asp-for="ExpirationDate" class="form-control bg-dark border-secondary text-white" placeholder="MM/YY" required />
                            <span asp-validation-for="ExpirationDate" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CVV" class="form-label text-secondary" style="font-size: 0.85rem;"></label>
                            <input asp-for="CVV" class="form-control bg-dark border-secondary text-white" placeholder="123" required />
                            <span asp-validation-for="CVV" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary Column -->
            <div class="col-lg-5">
                <div class="glass-card p-4 sticky-top" style="top: 100px; z-index: 10;">
                    <h4 class="fw-bold text-white mb-4 border-bottom border-secondary pb-3">Order Summary</h4>
                    
                    <!-- Cart items list (compact) -->
                    <div class="mb-4" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var item in cart)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=50&q=80" : item.ImageUrl)" 
                                         alt="@item.ProductName" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover; border: 1px solid var(--border-color);" />
                                    <div>
                                        <h6 class="text-white fw-bold mb-0" style="font-size: 0.85rem; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.ProductName</h6>
                                        <small class="text-secondary">Qty: @item.Quantity</small>
                                    </div>
                                </div>
                                <span class="text-white fw-bold" style="font-size: 0.9rem;">$@item.TotalPrice.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <hr class="border-secondary">

                    <div class="d-flex justify-content-between mb-2 text-secondary" style="font-size: 0.9rem;">
                        <span>Cart Subtotal:</span>
                        <span>$@cartTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-secondary" style="font-size: 0.9rem;">
                        <span>Shipping & Handling:</span>
                        <span class="text-success">FREE</span>
                    </div>
                    
                    <hr class="border-secondary">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-white fw-bold">Grand Total:</span>
                        <span class="text-primary fw-bold fs-4">$@cartTotal.ToString("N2")</span>
                    </div>

                    <button type="submit" class="btn btn-camping-primary w-100 py-3 mb-3">
                        <i class="bi bi-shield-lock-fill me-2"></i>Authorize & Place Order
                    </button>
                    
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-camping-outline w-100 py-2">
                        <i class="bi bi-arrow-left me-1"></i>Return to Cart
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
